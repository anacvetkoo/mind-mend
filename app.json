{
  "expo": {
    "name": "MindMend",
    "slug": "mind-mend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mindmend_app_icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "mindmend",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "MindMend uses Face ID to protect your account."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "package": "com.mindmend.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "bcbde360-111d-4d94-ad8b-679d820f6ae1"
      }
    },
    "plugins": [
      "expo-web-browser"
    ]
  }
}
